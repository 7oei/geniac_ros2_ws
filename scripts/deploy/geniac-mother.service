[Unit]
Description=GENIAC mother visualizer
After=graphical-session.target
[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=%t/gdm/Xauthority
ExecStart=%h/geniac_ros2_ws/scripts/geniac-mother
Restart=on-failure
RestartSec=5
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=60
[Install]
WantedBy=default.target
