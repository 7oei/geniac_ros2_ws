#!/bin/bash
set -e
GENIAC_WS=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
GENIAC_HAP_WS=${GENIAC_HAP_WS:-$HOME/armadillo_ros2_ws}
source /opt/ros/humble/setup.bash
source "$GENIAC_HAP_WS/install/local_setup.bash"
export GENIAC_PEER_IP=${GENIAC_PEER_IP:-192.168.1.42}
export GENIAC_INTERFACE=${GENIAC_INTERFACE:-wlp4s0}
source "$GENIAC_WS/scripts/geniac-local-network.sh"
exec ros2 run livox_ros_driver2 livox_ros_driver2_node --ros-args \
  -r __node:=k5_hap_publisher -p xfer_format:=0 -p multi_topic:=0 -p data_src:=0 \
  -p publish_freq:=10.0 -p output_data_type:=0 -p frame_id:=livox_frame \
  -p user_config_path:="$GENIAC_HAP_WS/src/livox_ros_driver2/config/HAP_config.json"
