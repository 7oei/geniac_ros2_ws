[Unit]
Description=GENIAC stationary LiDAR, camera and scenario service
After=network-online.target geniac-hap.service geniac-audio.service
Wants=geniac-hap.service geniac-archive.service geniac-audio.service geniac-watchdog.service geniac-lan-bridge.service geniac-webrtc.service
[Service]
Type=simple
ExecStart=%h/geniac_ros2_ws/scripts/geniac-sensor
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=60
[Install]
WantedBy=default.target
